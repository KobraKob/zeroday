# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Security & Background Cron Keys
CRON_SECRET=your_super_secret_cron_token_here
ADMIN_SECRET=your_super_secret_admin_token_here

# Groq API Configuration for ZeroDay Grounded Intelligence Engine
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Standalone Backend URL (for Vercel Frontend -> Railway Backend deployment)
BACKEND_URL=https://your-zeroday-backend.up.railway.app
NEXT_PUBLIC_BACKEND_URL=https://your-zeroday-backend.up.railway.app

# Backend Server Port (Default: 8080)
PORT=8080
